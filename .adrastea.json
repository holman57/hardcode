{
  "name": "hardcode",
  "version": "1.1.0",
  "owner": "holman57",
  "description": "Flashcard syntax memorization and Computer Science learning system for humans.",
  "tech_stack": {
    "frontend": "Flutter / Dart (lib/main.dart, pubspec.yaml)",
    "cli_driver": "Python (python_driver.py)",
    "catalog_database": "assets/knowledge_graph.json"
  },
  "test_command": "python -m unittest test.test_python_driver",
  "test_commands": {
    "unit": "python -m unittest test.test_python_driver",
    "ui_simulation": "npx playwright test --reporter=json",
    "chaos_suite": "npx playwright test test/e2e/chaos_game_breaker.spec.ts --reporter=json",
    "loading_recovery": "npx playwright test test/e2e/loading_recovery.spec.ts",
    "question_progression": "npx playwright test test/e2e/question_progression.spec.ts",
    "kg_3d_human_tests": "npx playwright test test/e2e/knowledge_graph_3d.spec.ts",
    "auto_tune": "python scripts/tune_test_suite.py",
    "agent_commit_gate": "python scripts/agent_test_commit_loop.py --check-only",
    "agent_commit_loop": "python scripts/agent_test_commit_loop.py -m"
  },
  "workflow_policy": {
    "enforce_test_branch": true,
    "branch_prefix": "agent/feat-",
    "acceptance_threshold": 0.85,
    "require_ui_simulation_to_merge": true,
    "auto_merge_on_threshold": true,
    "max_autonomous_iterations": 8
  },
  "invariants": [
    "no_double_accounting_on_spam_click",
    "no_unhandled_runtime_exceptions",
    "graceful_boundary_handling_on_partial_submits",
    "deterministic_state_transitions"
  ],
  "question_types": [
    "Multi-Choice",
    "True-False",
    "Matching",
    "Sequencing",
    "Sorting-Classification"
  ],
  "curriculum_domains": [
    "Computer Science",
    "System Architecture",
    "Artificial Intelligence",
    "Operating Systems",
    "Computer Networking",
    "Algorithms",
    "Data Structures",
    "Automata & Formal Languages",
    "Discrete Mathematics",
    "Asymptotic Complexity Analysis",
    "Software Engineering",
    "Cloud & Distributed Computing"
  ],
  "pedagogical_rules": {
    "first_time_explanation": true,
    "multi_miss_remediation": true,
    "outright_failure_deep_explanation": true,
    "explanation_throttling": {
      "enabled": true,
      "decay_strategy": "exponential_frequency_reduction"
    }
  },
  "active_issues": [2, 4]
}
